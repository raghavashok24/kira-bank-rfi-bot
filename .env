# Copy this file to .env and fill in real values. NEVER commit the real .env file.
#
# Get these from your Sumsub Dashboard (Integrations -> App Tokens). Rotate
# them if they were ever pasted into a chat, ticket, or shared doc.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Strongly recommended: the secret key shown in Sumsub Dashboard -> Webhook
# manager when you create/edit the webhook. Without this, the bot accepts
# any POST to /api/webhooks/sumsub at face value. Same rotation rule as
# above if it's ever pasted anywhere outside this file / Render's
# Environment tab.
SUMSUB_WEBHOOK_SECRET_KEY=

# Optional: Slack notifications (startup status, every new confirmed
# "bank rfi" transaction, and any candidate newly scored high-risk). Leave
# both blank to run with Slack entirely off -- nothing else changes.
# SLACK_BOT_TOKEN needs a Slack app with the chat:write scope, installed to
# your workspace; SLACK_CHANNEL is the channel ID or name (e.g.
# "#kyt-alerts") the bot has been invited to. Same rotation rule as the
# Sumsub secrets above.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Optional overrides -- all have working defaults, nothing below is required:
# SUMSUB_BASE_URL=https://api.sumsub.com
# BANK_RFI_TAG=bank rfi
# MIN_ML_SAMPLES=15
# INGEST_INTERVAL_MINUTES=60
# BOT_DB_PATH=./bank_rfi_bot.db
# SLACK_HIGH_RISK_THRESHOLD=0.75
